# Database Configuration (Required)
# PostgreSQL connection string from Supabase or your database provider
# Prisma 7 reads this in two places: prisma.config.ts for migrate and
# generate, and lib/db/prisma.ts, which hands it to the pg driver adapter.
# DIRECT_URL is gone. Prisma 7 removed `directUrl` and opens the direct
# connection for migrations itself.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Authentication (Required)
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business API (Optional - for WhatsApp notifications)
# Get these from Meta Business Platform: https://business.facebook.com
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_BUSINESS_ID=""
# Required. The number owner notices (notifyOwner(), lib/services/owner-line.ts)
# are sent to, and the number the client portal's error page
# (lib/portal/whatsapp-link.ts) offers as a direct link. Local (05...) or
# international (972...) format both work.
OWNER_PHONE="972501234567"

# WAHA (self-hosted WhatsApp HTTP API) - the CRM's outbound notice pipe
WAHA_API_URL="http://your-vps:3001"
WAHA_API_KEY=""
# The session every outbound notice goes out on (botSessionName() in
# lib/services/waha-transport.ts). Nothing listens on this session anymore,
# but notifyOwner() and all three client notices still send from it.
WAHA_BOT_SESSION="bot"

# Website lead intake (/api/public/leads). Required: the endpoint rejects every
# submission while this is unset — it fails closed. The site (itayost.com)
# holds the same value as CRM_LEAD_SECRET and sends it in the x-lead-secret
# header from its own server, never from the visitor's browser.
# Generate: openssl rand -hex 32. Rotating means updating both projects.
PUBLIC_LEAD_SECRET=""

# Email Configuration (Optional - future feature)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# Supabase storage (request attachments and WhatsApp media)
# SUPABASE_URL is read server-side by storage.service.ts. Without it every
# upload throws and attachments are silently dropped.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Morning (Green Invoice) API - Israeli Invoicing System
# Get API key from: https://app.greeninvoice.co.il/settings/api
MORNING_API_KEY=""
MORNING_API_SECRET=""
MORNING_API_URL="https://api.greeninvoice.co.il/api/v1"
ENABLE_MORNING_INTEGRATION="false"

# Google Calendar (Optional - future feature)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File Storage (Optional - future feature)
# For uploading project files, invoices, etc.
STORAGE_PROVIDER="local"  # or "s3", "cloudinary"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Error Tracking (Optional)
SENTRY_DSN=""

# Feature Flags
ENABLE_WHATSAPP="false"
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_PUBLIC_API="true"

# Development
NODE_ENV="development"  # or "production"

# Agent API key — used by project-health-agent to authenticate to /api/v1/agent/*.
# 32-byte hex; rotate by regenerating + updating both crm-system and agent env.
AGENT_API_KEY=