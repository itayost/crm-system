# Database Configuration (Required)
# PostgreSQL connection string from Supabase or your database provider
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Authentication (Required)
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business API (Optional - for WhatsApp notifications)
# Get these from Meta Business Platform: https://business.facebook.com
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_BUSINESS_ID=""
# Required. Both WAHA webhooks (/api/whatsapp/index, /api/whatsapp/webhook) reject
# every request while this is unset — they fail closed.
WHATSAPP_WEBHOOK_SECRET=""
# Required for the bot session. Only this number reaches the owner agent and its CRM
# tools; everyone else is routed to the client/hold path. Local (05...) or
# international (972...) format both work.
OWNER_PHONE="972501234567"

# WAHA (self-hosted WhatsApp HTTP API) - powers indexing and the bot
WAHA_API_URL="http://your-vps:3001"
WAHA_API_KEY=""
WAHA_PERSONAL_SESSION="personal"  # passive indexing session
WAHA_BOT_SESSION="bot"            # interactive owner/support session

# Pause switch for the client-facing bot. Set to 1 and redeploy: client and
# unknown senders are dropped at the webhook with no reply, no archived message
# and no ticket, and the hourly follow-up reminders stop. The owner agent and
# the morning brief keep running. Unset (or 0/false/off/no) means running;
# anything else means paused. Empty here so a fresh checkout is not paused.
WHATSAPP_BOT_PAUSED=""

# GitHub fine-grained token, READ-ONLY (contents: read). Lets the support agent
# consult a client project's repository to ask sharper questions. Optional: the
# agent works without it, just without repo context.
GITHUB_TOKEN=""

# Model per role. The source of truth is lib/ai/models.ts; leaving these unset
# uses the defaults it declares, which is what you usually want. Uncomment one
# only to pin that single role to a different AI Gateway id. Values are read at
# call time, so a change needs a restart, not a rebuild.
# SUPPORT_CHAT_MODEL="anthropic/claude-sonnet-4.6"
# WHATSAPP_AGENT_MODEL="anthropic/claude-sonnet-4.6"
# INTAKE_MODEL="anthropic/claude-sonnet-4.6"
# REQUEST_EXTRACTION_MODEL="anthropic/claude-sonnet-4.6"
# MORNING_BRIEF_MODEL="anthropic/claude-sonnet-4.6"
# PRODUCT_CARD_MODEL="anthropic/claude-sonnet-4.6"

# Transcribes/describes client voice notes, videos, and images. This role must
# stay vision-capable; a text-only model cannot serve it.
# SUPPORT_MEDIA_MODEL="google/gemini-2.5-flash"

# Website lead intake (/api/public/leads). Required: the endpoint rejects every
# submission while this is unset — it fails closed, like the WAHA webhooks. The
# site (itayost.com) holds the same value as CRM_LEAD_SECRET and sends it in the
# x-lead-secret header from its own server, never from the visitor's browser.
# Generate: openssl rand -hex 32. Rotating means updating both projects.
PUBLIC_LEAD_SECRET=""

# Email Configuration (Optional - future feature)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# Supabase storage (request attachments and WhatsApp media)
# SUPABASE_URL is read server-side by storage.service.ts. Without it every
# upload throws and attachments are silently dropped.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cron authentication. All three cron routes fail closed without it, so a
# deployment missing this value has silently dead crons.
CRON_SECRET=""

# AI Gateway (Vercel). Required by every model call: both WhatsApp agents,
# request extraction, the morning brief, and media transcription.
AI_GATEWAY_API_KEY=""

# Local model on the VPS (Ollama behind an authenticated reverse proxy).
# Fallback for the support bot when the gateway fails; primary for the
# morning brief. All three optional - unset disables the local tier.
# OLLAMA_BASE_URL must include the /v1 suffix (OpenAI-compatible surface).
# OLLAMA_MODEL defaults from lib/ai/models.ts like the gateway roles above.
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
# OLLAMA_MODEL="gemma4:e4b"

# Request extraction tuning (optional, defaults shown)
EXTRACTION_MIN_CONFIDENCE="0.55"
EXTRACTION_MAX_MESSAGES_PER_CLIENT="200"

# Morning (Green Invoice) API - Israeli Invoicing System
# Get API key from: https://app.greeninvoice.co.il/settings/api
MORNING_API_KEY=""
MORNING_API_SECRET=""
MORNING_API_URL="https://api.greeninvoice.co.il/api/v1"
ENABLE_MORNING_INTEGRATION="false"

# Google Calendar (Optional - future feature)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File Storage (Optional - future feature)
# For uploading project files, invoices, etc.
STORAGE_PROVIDER="local"  # or "s3", "cloudinary"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Error Tracking (Optional)
SENTRY_DSN=""

# Feature Flags
ENABLE_WHATSAPP="false"
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_PUBLIC_API="true"

# Development
NODE_ENV="development"  # or "production"

# Agent API key — used by project-health-agent to authenticate to /api/v1/agent/*.
# 32-byte hex; rotate by regenerating + updating both crm-system and agent env.
AGENT_API_KEY=