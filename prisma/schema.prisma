generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  clients  Client[]
  projects Project[]
  tasks    Task[]
  requests Request[]

  supportConversations SupportConversation[]
}

model Contact {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String
  company         String?
  status          ContactStatus @default(NEW)
  source          ContactSource
  estimatedBudget Decimal?      @db.Decimal(10, 2)
  projectType     String?
  isVip           Boolean       @default(false)
  address         String?
  taxId           String?
  notes           String?       @db.Text
  convertedAt     DateTime?
  lastContactedAt DateTime?

  // Membership in a Client (business)
  role      String?
  isPrimary Boolean @default(false)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])

  userId           String
  user             User               @relation(fields: [userId], references: [id])
  projects         Project[]          @relation("ProjectPrimaryContact")
  whatsappMessages WhatsAppMessage[]
  requests         Request[]

  supportConversations SupportConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([clientId])
}

model Project {
  id                 String              @id @default(cuid())
  name               String
  description        String?             @db.Text
  type               ProjectType
  status             ProjectStatus       @default(ACTIVE)
  priority           Priority            @default(MEDIUM)
  startDate          DateTime?
  deadline           DateTime?
  completedAt        DateTime?
  price              Decimal?            @db.Decimal(10, 2)
  retention          Decimal?            @db.Decimal(10, 2)
  retentionFrequency RetentionFrequency?

  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  primaryContactId String?
  primaryContact   Contact? @relation("ProjectPrimaryContact", fields: [primaryContactId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  tasks       Task[]
  requests    Request[]
  agentConfig AgentProjectConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deadline])
  @@index([clientId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    Priority     @default(MEDIUM)
  category    TaskCategory @default(CLIENT_WORK)
  dueDate     DateTime?
  completedAt DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([category])
}

model Client {
  id         String  @id @default(cuid())
  name       String
  isVip      Boolean @default(false)
  address    String?
  taxId      String?
  notes      String? @db.Text
  isInternal Boolean @default(false)
  formToken  String? @unique

  userId String
  user   User @relation(fields: [userId], references: [id])

  contacts Contact[]
  projects Project[]
  requests Request[]

  supportConversations SupportConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum ContactStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  CLIENT
  INACTIVE
}

enum ContactSource {
  WEBSITE
  PHONE
  WHATSAPP
  REFERRAL
  OTHER
}

enum ProjectType {
  LANDING_PAGE
  WEBSITE
  ECOMMERCE
  WEB_APP
  MOBILE_APP
  MANAGEMENT_SYSTEM
  CONSULTATION
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  CLIENT_WORK
  MARKETING
  LEAD_FOLLOWUP
  ADMIN
}

enum RetentionFrequency {
  MONTHLY
  YEARLY
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  phoneNumber String
  rawChatId   String?
  direction   MessageDirection
  content     String           @db.Text
  contactId   String?
  contact     Contact?         @relation(fields: [contactId], references: [id])
  clientId    String?
  sessionName String
  timestamp   DateTime
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  requests    Request[]

  @@index([phoneNumber])
  @@index([contactId])
  @@index([clientId])
  @@index([timestamp])
  @@index([processedAt])
  @@index([clientId, processedAt])
}

model BotConversation {
  id           String   @id @default(cuid())
  messages     Json
  ownerChatId  String?
  lastActiveAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One live support conversation per WhatsApp chat on the bot session.
model SupportConversation {
  id     String @id @default(cuid())
  chatId String

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  /// Trimmed rolling history: [{ role, content }]
  messages Json @default("[]")
  /// The request summary awaiting the client's confirmation, if any.
  pendingDraft        Json?
  confirmationAskedAt DateTime?
  remindersSent       Int       @default(0)

  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([clientId])
  @@index([confirmationAskedAt])
}

model AgentProjectConfig {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agentSlug String   @unique
  status    AgentMonitoringStatus @default(ACTIVE)

  githubOwner  String
  githubRepo   String
  githubBranch String  @default("main")

  vercelTeamId    String
  vercelProjectId String

  supabaseProjectRef String?
  smokeUrl           String?
  domains            String[] @default([])

  safetyConfig         Json
  morningReportInclude Boolean @default(true)
  ingestionConfig      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum AgentMonitoringStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model Request {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  type        RequestType   @default(REQUEST)
  status      RequestStatus @default(OPEN)
  priority    Priority      @default(MEDIUM)
  source      RequestSource @default(MANUAL)

  isAiGenerated Boolean @default(false)
  aiConfidence  Float?
  aiNote        String? @db.Text
  attachments   String[] @default([])

  sourceMessageId String?
  sourceMessage   WhatsAppMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([userId, status])
  @@index([sourceMessageId])
}

enum RequestType {
  REQUEST
  BUG
  IMPROVEMENT
  QUESTION
  OTHER
}

enum RequestStatus {
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum RequestSource {
  WHATSAPP
  MANUAL
  EMAIL
  FORM
  OTHER
}
