generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  clients  Client[]
  projects Project[]
  tasks    Task[]
  requests Request[]

  supportConversations SupportConversation[]
}

model Contact {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String
  company         String?
  status          ContactStatus @default(NEW)
  source          ContactSource
  estimatedBudget Decimal?      @db.Decimal(10, 2)
  projectType     String?
  isVip           Boolean       @default(false)
  address         String?
  taxId           String?
  notes           String?       @db.Text
  convertedAt     DateTime?
  lastContactedAt DateTime?

  /// The one thing owed to this lead next, and when. Cleared once the lead
  /// reaches a terminal status - there is nothing left to chase.
  nextActionAt   DateTime?
  nextActionNote String?   @db.Text

  // Membership in a Client (business)
  role      String?
  isPrimary Boolean @default(false)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])

  userId           String
  user             User              @relation(fields: [userId], references: [id])
  projects         Project[]         @relation("ProjectPrimaryContact")
  whatsappMessages WhatsAppMessage[]
  requests         Request[]

  supportConversations SupportConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@index([clientId])
  @@index([userId, nextActionAt])
}

model Project {
  id                 String              @id @default(cuid())
  name               String
  description        String?             @db.Text
  type               ProjectType
  status             ProjectStatus       @default(ACTIVE)
  priority           Priority            @default(MEDIUM)
  startDate          DateTime?
  deadline           DateTime?
  completedAt        DateTime?
  /// Paid up front to start. The rest of the money lives on the phases.
  advanceAmount      Decimal?            @db.Decimal(10, 2)
  advancePaidAt      DateTime?
  retention          Decimal?            @db.Decimal(10, 2)
  retentionFrequency RetentionFrequency?

  clientId         String
  client           Client              @relation(fields: [clientId], references: [id])
  primaryContactId String?
  primaryContact   Contact?            @relation("ProjectPrimaryContact", fields: [primaryContactId], references: [id])
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  tasks            Task[]
  requests         Request[]
  phases           ProjectPhase[]
  agentConfig      AgentProjectConfig?
  productCard      ProductCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, status])
  @@index([deadline])
  @@index([clientId])
  @@index([primaryContactId])
}

/// A billable stage of a project: its own price, its own sign-off, its own
/// payment. Scoped through the project rather than carrying a userId, the same
/// way AgentProjectConfig is.
model ProjectPhase {
  id         String      @id @default(cuid())
  name       String
  order      Int
  status     PhaseStatus @default(NOT_STARTED)
  price      Decimal     @default(0) @db.Decimal(10, 2)
  /// Signed off by the client. Says nothing about whether they have paid.
  approvedAt DateTime?
  /// Set only by an explicit "סמן כשולם" - un-approving does not un-pay.
  paidAt     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, order])
  @@index([status])
}

/// The support bot's authoritative description of the delivered product a
/// client uses - screens, flows, vocabulary, what does not exist - written in
/// Hebrew and injected whole into the support prompt. Regenerated from the
/// repo when its HEAD moves; the owner's manual notes survive regeneration
/// and win on conflict. Scoped through the project, like AgentProjectConfig.
model ProductCard {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The generated card body, Hebrew prose with English identifiers.
  cardHe        String  @db.Text
  /// Owner-authored additions appended after the generated body - e.g. the
  /// Android app's screens, which no page.tsx glob can see.
  manualNotesHe String? @db.Text

  /// HEAD of the configured branch when the card was generated. The nightly
  /// refresh skips repos whose HEAD has not moved.
  commitSha   String?
  generatedAt DateTime?
  /// What inputs built it (routes counted, i18n found, README length) - for
  /// debugging a bad card, not for the prompt.
  sourceNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    Priority     @default(MEDIUM)
  category    TaskCategory @default(CLIENT_WORK)
  dueDate     DateTime?
  completedAt DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  /// Set when this task was created by approving a client request.
  request Request?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([userId, status])
  @@index([category])
}

model Client {
  id         String  @id @default(cuid())
  name       String
  isVip      Boolean @default(false)
  address    String?
  taxId      String?
  notes      String? @db.Text
  /// What the support bot may know about this client - and may therefore say.
  /// Bot-visible by design; `notes` above stays owner-private and never
  /// reaches a prompt. Fixed Markdown sections, מילון being the one the bot
  /// itself appends to.
  profileHe  String? @db.Text
  isInternal Boolean @default(false)
  formToken  String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  contacts Contact[]
  projects Project[]
  requests Request[]

  supportConversations SupportConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  USER
}

/// NEW..QUOTED are the lead pipeline; LOST ends a lead, INACTIVE ends a client.
enum ContactStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUOTED
  CLIENT
  LOST
  INACTIVE
}

enum ContactSource {
  WEBSITE
  PHONE
  WHATSAPP
  REFERRAL
  OTHER
}

enum ProjectType {
  LANDING_PAGE
  WEBSITE
  ECOMMERCE
  WEB_APP
  MOBILE_APP
  MANAGEMENT_SYSTEM
  CONSULTATION
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

/// PENDING_APPROVAL and REVISIONS cycle until the client stops finding things,
/// so this is not a straight line and the UI must not offer a "next" button.
enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_APPROVAL
  REVISIONS
  APPROVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  CLIENT_WORK
  MARKETING
  LEAD_FOLLOWUP
  ADMIN
}

enum RetentionFrequency {
  MONTHLY
  YEARLY
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  /// WAHA's own message id. Lets a redelivered webhook be recognised rather
  /// than archived and answered twice.
  externalId  String?          @unique
  phoneNumber String
  rawChatId   String?
  direction   MessageDirection
  content     String           @db.Text
  contactId   String?
  contact     Contact?         @relation(fields: [contactId], references: [id])
  clientId    String?
  sessionName String
  timestamp   DateTime
  processedAt DateTime?

  /// Stored original of a voice note, video, or image sent with this message.
  mediaPath     String?
  mediaMimeType String?
  /// What the media said or showed, as understood by the transcription model.
  transcript    String?  @db.Text
  createdAt     DateTime @default(now())

  requests Request[]

  @@index([phoneNumber])
  @@index([contactId])
  @@index([clientId])
  @@index([timestamp])
  @@index([processedAt])
  @@index([clientId, processedAt])
}

model BotConversation {
  id           String   @id @default(cuid())
  messages     Json
  ownerChatId  String?
  lastActiveAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One live support conversation per WhatsApp chat on the bot session.
model SupportConversation {
  id     String @id @default(cuid())
  chatId String

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  /// Trimmed rolling history: [{ role, content }]
  messages            Json      @default("[]")
  /// The request summary awaiting the client's confirmation, if any.
  pendingDraft        Json?
  confirmationAskedAt DateTime?
  remindersSent       Int       @default(0)
  /// How many times a summary has been put to this client without a ticket
  /// coming out of it. The guarantee that "זה מדויק?" cannot repeat forever.
  confirmationRounds  Int       @default(0)
  /// Media sent in this conversation that the next filed request should carry:
  /// [{ path, mimeType, transcribed }]
  pendingMedia        Json      @default("[]")
  /// Internal repository findings for the next filed request's AI note.
  repoFindings        Json      @default("[]")

  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([clientId])
  @@index([contactId])
  @@index([confirmationAskedAt])
}

model AgentProjectConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agentSlug String                @unique
  status    AgentMonitoringStatus @default(ACTIVE)

  githubOwner  String
  githubRepo   String
  githubBranch String @default("main")

  vercelTeamId    String
  vercelProjectId String

  supabaseProjectRef String?
  smokeUrl           String?
  domains            String[] @default([])

  safetyConfig         Json
  morningReportInclude Boolean @default(true)
  ingestionConfig      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum AgentMonitoringStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model Request {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  type        RequestType   @default(REQUEST)
  status      RequestStatus @default(OPEN)
  priority    Priority      @default(MEDIUM)
  source      RequestSource @default(MANUAL)

  isAiGenerated Boolean  @default(false)
  aiConfidence  Float?
  aiNote        String?  @db.Text
  attachments   String[] @default([])
  /// Structured intake gathered by the support agent:
  /// { where, whatHappened, expected, frequency, workedBefore, blocking, goal, today, suggestedType }
  intake        Json?

  sourceMessageId String?
  sourceMessage   WhatsAppMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  /// The work item this request became when it was approved. One Task per Request.
  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([userId, status])
  @@index([sourceMessageId])
  @@index([contactId])
  @@index([projectId])
}

enum RequestType {
  REQUEST
  BUG
  IMPROVEMENT
  QUESTION
  OTHER
}

enum RequestStatus {
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum RequestSource {
  WHATSAPP
  MANUAL
  EMAIL
  FORM
  OTHER
}
